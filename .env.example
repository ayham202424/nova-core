# Discord Bot credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_server_id_here

# Channel IDs (right-click channel -> Copy Channel ID, Developer Mode must be on)
VERIFY_CHANNEL_ID=
VERIFY_HELP_CHANNEL_ID=

# Role IDs (right-click role in Server Settings -> Copy Role ID)
UNVERIFIED_ROLE_ID=
MEMBER_ROLE_ID=
